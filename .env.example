APP_ENV=development
PORT=8080
# Host do banco (é isso que escolhe externo vs interno):
#   localhost            = Postgres da máquina com go run
#   host.docker.internal = Postgres da máquina com a API no Docker
#   postgres             = Postgres interno (docker compose --profile db up)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=atlas_knowledge
POSTGRES_SSLMODE=disable
# Alternativa: uma connection string completa (sobrescreve as variáveis acima)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/atlas_knowledge?sslmode=disable
ADMIN_EMAIL=root@gmail.com
ADMIN_PASSWORD=12345
ADMIN_NAME=Administrador
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
STORAGE_PATH=./storage
MAX_UPLOAD_BYTES=20971520
CORS_ORIGINS=http://localhost:5173
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax
AI_SERVICE_URL=http://localhost:8081
AI_SERVICE_TIMEOUT=30m
# Credenciais do provedor (AI_PROVIDER / AI_MODEL / AI_API_KEY / AI_BASE_URL)
# ficam na tabela ai_settings — configure via PUT /api/v1/ai-settings (admin).
DOC_MAX_FILES=20
DOC_MAX_FILE_BYTES=20971520
DOC_MAX_TOTAL_BYTES=104857600
# Chave opcional para o Mnemos (ou automação) chamar /api/v1/mnemos/*
# Header: X-Api-Key: <valor>
MNEMOS_API_KEY=
