# Copie para .env no servidor de produção:
#   cp .env.production.example .env
# Depois troque TODOS os valores marcados com CHANGE_ME.

APP_ENV=production
PORT=8080

# Banco: preencha usuário, senha, nome e HOST (o host escolhe externo vs interno).
#   host.docker.internal = Postgres da máquina
#   hostname do RDS      = banco gerenciado (use POSTGRES_SSLMODE=require)
#   postgres             = Postgres interno (docker compose --profile db up -d)
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=atlas_knowledge
POSTGRES_SSLMODE=disable

# JWT — gere um segredo longo, por exemplo:
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Primeiro admin (só é criado se o banco estiver vazio)
ADMIN_EMAIL=admin@suaempresa.com
ADMIN_PASSWORD=CHANGE_ME
ADMIN_NAME=Administrador

# Front e URL pública da API (downloads de anexos)
CORS_ORIGINS=https://app.suaempresa.com
API_BASE_URL=https://api.suaempresa.com

# Cookie de refresh: Secure em HTTPS. Use none se o front estiver em outro domínio.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

STORAGE_PATH=/data/storage
MAX_UPLOAD_BYTES=20971520

# Mnemos no Docker: use o nome do container na rede atlas-mnemos, NÃO localhost.
# No compose do Mnemos: networks.atlas-mnemos.external = true (name: atlas-mnemos)
# e a URL da Atlas deve ser http://atlas:8080 (sync /api/v1/mnemos e /api/v1/internal).
AI_SERVICE_URL=http://mnemos:8081
AI_SERVICE_TIMEOUT=30m
MNEMOS_API_KEY=CHANGE_ME

DOC_MAX_FILES=20
DOC_MAX_FILE_BYTES=20971520
DOC_MAX_TOTAL_BYTES=104857600
